rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Audit logs can be written by authenticated actions or app audit logger and read by authenticated users
    match /audit_logs/{logId} {
      allow read, write: if true;
    }
    
    // System users
    match /users/{userId} {
      allow read, write: if true;
    }

    // Orders & Customers collections
    match /orders/{orderId} {
      allow read, write: if true;
    }

    match /customers/{customerId} {
      allow read, write: if true;
    }

    match /{document=**} {
      allow read, write: if true;
    }
  }
}
